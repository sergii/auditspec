{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditspec.dev/schema/0.1/remediation-plan.schema.json",
  "title": "AuditSpec Remediation Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_version", "generated_at", "subject", "source_assessment", "items"],
  "properties": {
    "plan_version": { "const": "0.1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "source_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "inspector"],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "inspector": { "type": "string", "minLength": 1 }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "summary", "rationale", "acceptance_criteria"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["code_change", "test", "config", "documentation", "runtime_verification"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_fingerprint", "rule_id", "title", "confidence", "location", "actions", "verification"],
      "properties": {
        "finding_fingerprint": { "type": "string", "minLength": 1 },
        "rule_id": { "type": "string", "pattern": "^AS-[A-Z]+-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["certain", "high", "medium", "low"] },
        "location": { "$ref": "#/$defs/location" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action" }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected_fingerprint_absent"],
          "properties": {
            "expected_fingerprint_absent": { "const": true },
            "notes": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
