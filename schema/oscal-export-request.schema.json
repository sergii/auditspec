{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditspec.dev/schema/0.1/oscal-export-request.schema.json",
  "title": "AuditSpec OSCAL Export Request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment_plan_href"],
  "properties": {
    "assessment_plan_href": {
      "type": "string",
      "minLength": 1,
      "description": "Resolvable URI reference to the OSCAL Assessment Plan governing the assessment."
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "start": { "type": "string", "format": "date-time" },
    "end": { "type": "string", "format": "date-time" }
  }
}
