{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditspec.dev/schema/0.1/oscal-export-request.schema.json",
  "title": "AuditSpec OSCAL Export Request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment_plan_href", "reviewed_control_ids", "finding_targets"],
  "properties": {
    "assessment_plan_href": {
      "type": "string",
      "minLength": 1,
      "description": "Resolvable URI reference to the OSCAL Assessment Plan governing the assessment."
    },
    "reviewed_control_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "Caller-supplied OSCAL control identifiers that were actually reviewed. AuditSpec does not infer assessment scope."
    },
    "finding_targets": {
      "type": "object",
      "description": "Caller-supplied OSCAL finding target/status by AuditSpec finding fingerprint. Every exported finding must have a mapping.",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/findingTarget" }
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "start": { "type": "string", "format": "date-time" },
    "end": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "findingTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_id", "status"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["statement-id", "objective-id"]
        },
        "target_id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {
              "type": "string",
              "enum": ["satisfied", "not-satisfied"]
            },
            "reason": { "type": "string", "minLength": 1 },
            "remarks": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
