{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditspec.dev/schema/0.1/evidence-query-result.schema.json",
  "title": "AuditSpec Evidence Query Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_version", "generated_at", "subject", "filters", "count", "items"],
  "properties": {
    "query_version": { "const": "0.1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "const": "repository" },
        "path": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "rule_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["certain", "high", "medium", "low"] },
        "source": { "enum": ["boundary", "finding"] }
      }
    },
    "count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "evidence", "confidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "enum": ["boundary", "finding"] },
          "boundary_id": { "type": "string", "minLength": 1 },
          "finding_id": { "type": "string", "minLength": 1 },
          "rule_id": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["certain", "high", "medium", "low"] },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "detail"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "detail": { "type": "string", "minLength": 1 },
              "location": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "line": { "type": "integer", "minimum": 1 },
                  "column": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
