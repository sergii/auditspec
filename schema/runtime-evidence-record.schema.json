{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditspec.dev/schema/0.1/runtime-evidence-record.schema.json",
  "title": "AuditSpec Runtime Evidence Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_version", "id", "kind", "producer", "trust", "observed_at", "observation"],
  "properties": {
    "record_version": { "const": "0.1" },
    "id": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": [
        "application_execution",
        "authorization_decision",
        "transaction_commit",
        "audit_persist",
        "outbox_persist",
        "delivery_receipt",
        "trace_span",
        "database_observation",
        "kernel_observation"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["application", "database", "collector", "proxy", "kernel", "agent", "external"]
        },
        "version": { "type": "string", "minLength": 1 },
        "instance": { "type": "string", "minLength": 1 }
      }
    },
    "trust": {
      "type": "string",
      "enum": ["authoritative", "attributed", "self_reported", "derived"]
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boundary_fingerprint": { "type": "string", "minLength": 1 },
        "finding_fingerprint": { "type": "string", "minLength": 1 },
        "assurance_node_id": { "type": "string", "minLength": 1 }
      },
      "minProperties": 1
    },
    "assessment_relation": {
      "type": "string",
      "enum": ["supports", "contradicts", "inconclusive"],
      "description": "Explicit relation to an Assessment finding/target when raw observation state alone cannot determine whether the assessment claim is supported or contradicted. Required for finding_fingerprint targets."
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "span_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "tool_call_id": { "type": "string", "minLength": 1 },
        "event_source": { "type": "string", "minLength": 1 },
        "event_id": { "type": "string", "minLength": 1 }
      },
      "minProperties": 1
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "coverage", "detail"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["observed", "not_observed", "contradicted"]
        },
        "coverage": {
          "type": "string",
          "enum": ["point", "sampled", "window", "exhaustive"]
        },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "metadata": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "anyOf": [
    { "required": ["targets"] },
    { "required": ["correlation"] }
  ],
  "allOf": [
    {
      "if": {
        "required": ["targets"],
        "properties": {
          "targets": { "required": ["finding_fingerprint"] }
        }
      },
      "then": { "required": ["assessment_relation"] }
    }
  ]
}
