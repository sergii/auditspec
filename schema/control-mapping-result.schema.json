{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditspec.dev/schema/0.1/control-mapping-result.schema.json",
  "title": "AuditSpec Control Mapping Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_version", "generated_at", "framework", "source_assessment", "controls", "caveat"],
  "properties": {
    "result_version": { "const": "0.1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "source_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_path", "generated_at"],
      "properties": {
        "subject_path": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_id", "relations"],
        "properties": {
          "control_id": { "type": "string", "minLength": 1 },
          "relations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule_id", "relation", "rationale", "finding_fingerprints"],
              "properties": {
                "rule_id": { "type": "string", "pattern": "^AS-[A-Z]+-[0-9]{3}$" },
                "relation": { "enum": ["relevant_evidence", "potential_gap"] },
                "rationale": { "type": "string", "minLength": 1 },
                "finding_fingerprints": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "caveat": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
