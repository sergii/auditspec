{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditspec.dev/schema/0.1/implementer-feedback-corpus.schema.json",
  "title": "AuditSpec Implementer Feedback Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_version",
    "evidence_status",
    "description",
    "scenarios"
  ],
  "properties": {
    "corpus_version": {
      "const": "0.1"
    },
    "evidence_status": {
      "enum": [
        "hypothesis",
        "observed",
        "mixed"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "focus",
          "situation",
          "misconception",
          "why_misleading",
          "takeaway",
          "spec_refs",
          "anti_pattern_events",
          "recommended_events",
          "expected_changed_fields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "focus": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "actor",
                "delegation",
                "source",
                "producer",
                "targets",
                "subjects",
                "authorization",
                "result",
                "evidence",
                "correlation",
                "identity",
                "time",
                "delivery"
              ]
            }
          },
          "situation": {
            "type": "string",
            "minLength": 1
          },
          "misconception": {
            "type": "string",
            "minLength": 1
          },
          "why_misleading": {
            "type": "string",
            "minLength": 1
          },
          "takeaway": {
            "type": "string",
            "minLength": 1
          },
          "spec_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(SPEC\\.md|spec/[a-z0-9-]+\\.md)#"
            }
          },
          "anti_pattern_events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "recommended_events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "expected_changed_fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "source",
                "id",
                "idempotency_key",
                "actor",
                "delegation",
                "targets",
                "subjects",
                "authorization",
                "result",
                "producer",
                "correlation",
                "evidence",
                "occurred_at",
                "recorded_at"
              ]
            }
          }
        }
      }
    }
  }
}
