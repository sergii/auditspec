{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditspec.dev/schema/0.1/assurance-graph-diff.schema.json",
  "title": "AuditSpec Assurance Graph Diff v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diff_version",
    "generated_at",
    "base",
    "head",
    "new_entrypoints",
    "removed_entrypoints",
    "new_framework_dispatches",
    "removed_framework_dispatches",
    "new_mutation_paths",
    "removed_mutation_paths",
    "unchanged_mutation_paths",
    "summary"
  ],
  "properties": {
    "diff_version": { "const": "0.1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "base": { "$ref": "#/$defs/endpoint" },
    "head": { "$ref": "#/$defs/endpoint" },
    "new_entrypoints": { "type": "array", "items": { "$ref": "#/$defs/entrypoint" } },
    "removed_entrypoints": { "type": "array", "items": { "$ref": "#/$defs/entrypoint" } },
    "new_framework_dispatches": { "type": "array", "items": { "$ref": "#/$defs/dispatch" } },
    "removed_framework_dispatches": { "type": "array", "items": { "$ref": "#/$defs/dispatch" } },
    "new_mutation_paths": { "type": "array", "items": { "$ref": "#/$defs/mutationPath" } },
    "removed_mutation_paths": { "type": "array", "items": { "$ref": "#/$defs/mutationPath" } },
    "unchanged_mutation_paths": { "type": "integer", "minimum": 0 },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_path", "generated_at"],
      "properties": {
        "subject_path": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "qualified_name", "location"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "qualified_name": { "type": "string", "minLength": 1 },
        "framework": { "type": "string", "minLength": 1 },
        "surface_kind": { "type": "string", "minLength": 1 },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "from", "to", "framework_kind", "detail", "confidence", "location"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "framework_kind": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["high", "medium"] },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "mutationPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "entrypoint", "mutation", "mutation_location", "path", "roles", "confidence"],
      "properties": {
        "fingerprint": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "minLength": 1 },
        "mutation": { "type": "string", "minLength": 1 },
        "mutation_location": { "$ref": "#/$defs/location" },
        "path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "roles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "confidence": { "enum": ["certain", "high", "medium", "low"] }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_entrypoints", "head_entrypoints", "base_mutation_paths", "head_mutation_paths", "mutation_path_delta"],
      "properties": {
        "base_entrypoints": { "type": "integer", "minimum": 0 },
        "head_entrypoints": { "type": "integer", "minimum": 0 },
        "base_mutation_paths": { "type": "integer", "minimum": 0 },
        "head_mutation_paths": { "type": "integer", "minimum": 0 },
        "mutation_path_delta": { "type": "integer" }
      }
    }
  }
}
