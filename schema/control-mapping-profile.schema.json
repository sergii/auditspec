{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditspec.dev/schema/0.1/control-mapping-profile.schema.json",
  "title": "AuditSpec Control Mapping Profile v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["mapping_version", "framework", "rules"],
  "properties": {
    "mapping_version": { "const": "0.1" },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "controls"],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^AS-[A-Z]+-[0-9]{3}$" },
          "controls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "relation", "rationale"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "relation": { "enum": ["relevant_evidence", "potential_gap"] },
                "rationale": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "caveat": { "type": "string", "minLength": 1 }
  }
}
