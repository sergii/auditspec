{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditspec.dev/schema/0.1/observation-scope.schema.json",
  "title": "AuditSpec Runtime Observation Scope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope_version", "basis"],
  "properties": {
    "scope_version": { "const": "0.1" },
    "basis": { "type": "string", "enum": ["declared", "partial", "unknown"] },
    "environment": { "type": "string", "minLength": 1 },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "collection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "mode": {
          "type": "string",
          "enum": ["continuous", "sampled", "triggered", "manual", "unknown"]
        }
      }
    },
    "producers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["application", "database", "collector", "proxy", "kernel", "agent", "external"]
          },
          "version": { "type": "string", "minLength": 1 },
          "instance": { "type": "string", "minLength": 1 }
        }
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "basis": { "const": "declared" } },
        "required": ["basis"]
      },
      "then": {
        "required": ["environment", "window", "collection_policy", "producers"]
      }
    }
  ]
}
