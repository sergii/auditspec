    {
      "id": "impersonation-keeps-operator",
      "title": "Preserve the operator during impersonation",
      "focus": [
        "actor",
        "delegation"
      ],
      "situation": "Support operator admin:99 impersonates customer user:42 to inspect an account.",
      "misconception": "Record user 42 as actor because the application session is impersonating that user.",
      "why_misleading": "It hides who actually operated the session and destroys accountability for the impersonation action.",
      "takeaway": "Keep the operator as actor and record the impersonated principal in delegation with a safe reason/reference.",
