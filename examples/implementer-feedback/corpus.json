    {
      "id": "authorization-does-not-imply-execution",
      "title": "Separate authorization success from execution success",
      "focus": [
        "authorization",
        "result"
      ],
      "situation": "Policy allows invoice.pay, but the database fails before the payment state change commits.",
      "misconception": "Set result to succeeded because authorization was allowed.",
      "why_misleading": "Authorization and execution are separate facts; a positive decision does not prove the business operation succeeded.",
      "takeaway": "Record authorization allowed and execution failed independently.",
      "spec_refs": [
        "SPEC.md#8-authorization",
        "SPEC.md#9-execution-result"
      ],
