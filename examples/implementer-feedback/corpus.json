  "scenarios": [
    {
      "id": "agent-on-behalf-of-user",
      "title": "Keep the AI agent as the immediate actor",
      "focus": [
        "actor",
        "delegation"
      ],
      "situation": "Agent agent:7 executes invoice.pay after user 42 asks it to perform the payment.",
      "misconception": "Record the user as actor because the business intent originated with the user.",
      "why_misleading": "It erases the entity that directly caused the audited operation and collapses delegation into identity.",
      "takeaway": "actor is the immediate actor; the represented user belongs in the ordered delegation chain.",
      "spec_refs": [
        "SPEC.md#4-actor",
        "SPEC.md#5-delegation-and-impersonation"
      ],
      "anti_pattern_events": [
        {
          "spec_version": "0.1",
          "id": "aud_feedback_agent_bad",
          "source": "urn:example:billing",
          "actor": {
            "type": "user",
            "id": "42"
          },
          "action": "invoice.pay",
          "result": {
            "status": "succeeded"
          },
          "occurred_at": "2026-10-08T09:00:00Z",
          "recorded_at": "2026-10-08T09:00:00.010Z"
        }
      ],
      "recommended_events": [
        {
          "spec_version": "0.1",
          "id": "aud_feedback_agent_good",
          "source": "urn:example:billing",
          "actor": {
            "type": "agent",
            "id": "agent:7"
          },
          "action": "invoice.pay",
          "result": {
            "status": "succeeded"
          },
          "occurred_at": "2026-10-08T09:00:00Z",
          "recorded_at": "2026-10-08T09:00:00.010Z",
          "delegation": [
            {
              "relationship": "on_behalf_of",
              "principal": {
                "type": "user",
                "id": "42"
              }
            }
          ]
        }
      ],
      "expected_changed_fields": [
        "actor",
        "delegation"
      ]
    },
    {
      "id": "nested-delegation-order",
      "title": "Order delegation nearest to the actor first",
      "focus": [
        "delegation"
      ],
      "situation": "A child agent acts for a parent agent, which acts on behalf of user 42.",
      "misconception": "List the human principal first because the human is ultimately responsible.",
      "why_misleading": "AuditSpec delegation order is structural, not importance-ranked: the first entry is nearest to the immediate actor.",
      "takeaway": "For child -> parent -> user, the chain must be [parent, user].",
      "spec_refs": [
        "SPEC.md#5-delegation-and-impersonation",
        "spec/actors.md#actors-and-delegation"
      ],
