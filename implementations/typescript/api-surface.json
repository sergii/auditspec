        "runConformanceCorpus",
        "toCloudEvent",
        "toOpenTelemetryLog",
        "toW3CProvProjection",
        "validateAuditEvent",
        "validateConformanceCorpusReport"
      ]
    },
    "./experimental": {
      "stability": "experimental",
      "source": "src/experimental.ts",
      "description": "Executable non-Core and research APIs that may change incompatibly across 0.x releases."
    }
  },
  "stable_modules": [
    "src/version.ts",
    "src/types.ts",
    "src/normalize.ts",
    "src/redact.ts",
