{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/assurance-evaluation.ts"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "npm run test:assurance-model"
  },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  },
  "thresholds": {
    "high": 100,
    "low": 95,
    "break": 95
  }
}
